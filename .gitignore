.env
*.env
!*.env.example
*.key
# secrets/ — now tracked (private repo); individual sensitive files below stay out
client_secret*.json
token.json
token_*.json
token_*.bak
*.prescopefix.bak
*.sha256

# ─────────────────────────────────────────────────────────────
