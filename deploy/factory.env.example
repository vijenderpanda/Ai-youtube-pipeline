# ─────────────────────────────────────────────────────────────
# Factory worker config.  install.sh copies this to secrets/factory.env.
# The worker reads ONLY secrets/factory.env (KEY=VALUE lines).
# Never commit the filled-in copy — secrets/ is gitignored.
# ─────────────────────────────────────────────────────────────

# Supabase project that holds the job queue (factory_jobs) and storage bucket.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# service_role key (Supabase → Project Settings → API).  REQUIRED — the worker
# refuses to start without it.  Full DB + storage access; keep secret.
SUPABASE_SERVICE_KEY=your-service-role-key

# Bearer token the dashboard/API uses.  Only needed for the recorder/publisher
# helper scripts, not for claiming jobs.  Any long random string.
FACTORY_TOKEN=your-shared-dashboard-token

# Max concurrent `claude -p` jobs.  Heavy jobs (Remotion renders) stay serial
# regardless.  Tune to RAM: 1 = safest, 2–3 on a roomy box.
# 16 GB box (i7 + RTX 3060): keep at 2.  NEVER 3 with Chrome open.
FACTORY_MAX_PARALLEL=2

# ── GPU acceleration (NVIDIA NVENC) ──────────────────────────
# Video encoding in the assembly scripts offloads to the GPU when possible.
#   auto  (default) probe once; use the GPU only if a real test-encode works
#   force use NVENC without probing (only if you KNOW it works)
#   cpu   always libx264 (software)
# Verify with:  python3 scripts/gpu_check.py
FACTORY_FFMPEG_HWACCEL=auto

# Remotion (claude-tricks shorts) GPU/CPU tuning. Unset = Remotion defaults.
# Recommended on the RTX 3060 box:
FACTORY_REMOTION_GL=angle
FACTORY_REMOTION_CONCURRENCY=8
# FACTORY_REMOTION_HWACCEL=if-possible

# Override the ffmpeg binary if it isn't on PATH (e.g. a custom NVENC build):
# FACTORY_FFMPEG=/usr/local/bin/ffmpeg
