# ─────────────────────────────────────────────────────────────
# Factory worker config.  install.sh copies this to secrets/factory.env.
# The worker reads ONLY secrets/factory.env (KEY=VALUE lines).
# Never commit the filled-in copy — secrets/ is gitignored.
# ─────────────────────────────────────────────────────────────

# Supabase project that holds the job queue (factory_jobs) and storage bucket.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# service_role key (Supabase → Project Settings → API).  REQUIRED — the worker
# refuses to start without it.  Full DB + storage access; keep secret.
SUPABASE_SERVICE_KEY=your-service-role-key

# Bearer token the dashboard/API uses.  Only needed for the recorder/publisher
# helper scripts, not for claiming jobs.  Any long random string.
FACTORY_TOKEN=your-shared-dashboard-token

# Max concurrent `claude -p` jobs.  Heavy jobs (Remotion renders) stay serial
# regardless.  Tune to RAM: 1 = safest, 2–3 on a roomy box.
# NEVER set 3 on an 18 GB Mac while Chrome is open.
FACTORY_MAX_PARALLEL=2
