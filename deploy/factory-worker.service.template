# Linux systemd user unit template.
# install.sh substitutes __PYTHON__, __REPO__, __PATH__ and writes the result to
#   ~/.config/systemd/user/factory-worker.service
# then: systemctl --user daemon-reload && systemctl --user enable --now factory-worker
[Unit]
Description=AI YouTube factory worker (claims Supabase jobs, runs claude -p)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__REPO__
Environment=FACTORY_REPO=__REPO__
Environment=PATH=__PATH__
ExecStart=__PYTHON__ __REPO__/scripts/factory_worker.py
Restart=always
RestartSec=15
StandardOutput=append:__REPO__/logs/factory_worker.log
StandardError=append:__REPO__/logs/factory_worker.log

[Install]
WantedBy=default.target
