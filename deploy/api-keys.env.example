# ─────────────────────────────────────────────────────────────
# Generation API keys used by scripts/ (Leonardo, ElevenLabs, HeyGen, stock).
# install.sh copies this to .env at the repo root.  Only fill in the services
# the jobs you run actually need — the worker itself needs none of these.
# ─────────────────────────────────────────────────────────────
LEONARDO_API_KEY=
ELEVENLABSKEY=
ELEVENLABS_API_KEY=
HEYGEN=
HEYGEN_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
